# Copy to .env and fill in. Never commit a real .env.

# --- panel ---
PANEL_PORT=8080
PANEL_PUBLIC_URL=http://localhost:8080
# Push model: the panel connects OUT to each node's management port (3333). It
# has no inbound agent gateway. Access the UI over an SSH tunnel or behind TLS.

# Generate with: openssl rand -base64 32
PANEL_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_USER=smartdns
POSTGRES_DB=smartdns

ADMIN_EMAIL=admin@example.net
# Leave empty to have a strong password generated and printed once.
ADMIN_PASSWORD=

SMARTDNS_VERSION=2.0.0
TZ=Europe/Moscow
# Log level: debug | info | warn | error. Leave EMPTY to let the panel manage
# it (Настройки → Логирование). A value set here is a local override that the
# control plane will not touch — that is how you debug one host in isolation.
LOG_LEVEL=

# Docker log rotation. Without a cap the json-file driver grows until the disk
# is full. 3 x 10 MiB per container by default.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Set to "off" to see every repeated line instead of one line with a
# "suppressed" count. Only useful while reproducing a bug.
LOG_THROTTLE=on

# Lab mode lets the egress reach private addresses. NEVER enable in production.
LAB_MODE=0

BACKUP_DIR=./backups
BACKUP_INTERVAL_SEC=86400
BACKUP_RETENTION_DAYS=14

# --- node (used by node/deploy/*/docker-compose.yml) ---
# The bundle from the panel (Ноды → Добавить ноду). Carries the node's TLS
# identity and pins the panel — like remnanode's SECRET_KEY. Provisions once.
NODE_BUNDLE=
# Host port the panel connects to. Open it in the firewall ONLY for the panel IP.
MGMT_BIND=3333
# Two public IPs are recommended for ingress: one for DNS, one for the managed
# HTTPS proxy.
DNS_IP=0.0.0.0
PROXY_IP=0.0.0.0
DOH_PORT=8443
RELAY_PORT=8443
TLS_CERT_FILE=
TLS_KEY_FILE=
ALLOW_SELF_SIGNED_TLS=0
